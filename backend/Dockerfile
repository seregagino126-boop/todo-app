# ============================================
# ЭТАП 1: СБОРКА (build)
# ============================================

# Базовый образ — .NET SDK 10.
# SDK включает компилятор и все инструменты сборки.
# Это тяжёлый образ (~1 ГБ), нужен только для сборки.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

# Рабочая директория внутри контейнера.
# Все последующие команды выполняются здесь.
WORKDIR /src 

# Копируем ТОЛЬКО файл проекта (.csproj).
# Зачем отдельно: если исходники изменятся, но .csproj — нет,
# Docker переиспользует слой restore из кэша. Это ускоряет сборку.
COPY ["TodoApi.csproj", "./"]
 
# Восстанавливаем NuGet-пакеты (зависимости).
# Аналог `dotnet restore` локально.
RUN dotnet restore "TodoApi.csproj"

# Копируем все остальные файлы проекта.
# Делаем это ПОСЛЕ restore — чтобы кэш restore не сбрасывался
# при каждом изменении кода.
COPY . .

# Собираем проект в Release-конфигурации и кладём в /app/publish.
# -c Release — оптимизированная сборка для продакшена.
# -o /app/publish — куда положить результат.
# /p:UseAppHost=false — не создавать нативный исполняемый файл.
RUN dotnet publish "TodoApi.csproj" -c Release -o /app/publish /p:UseAppHost=false

# ============================================
# ЭТАП 2: ЗАПУСК (final)
# ============================================

# Берём образ только с runtime ASP.NET (без SDK).
# Лёгкий (~200 МБ), здесь нет компилятора.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final

# Рабочая директория для запущенного приложения.
WORKDIR /app

# Копируем результат сборки из первого этапа (build).
# Из /app/publish этапа build → в /app текущего этапа.
COPY --from=build /app/publish .

# Документируем: контейнер слушает порт 8080.
# Это не публикация порта — её делаем через `docker run -p`.
EXPOSE 8080

# Переменная окружения для ASP.NET:
# слушать все интерфейсы (0.0.0.0) на порту 8080.
ENV ASPNETCORE_URLS=http://0.0.0.0:8080

# Команда, которая запускается при старте контейнера.
# Запускает твоё приложение через dotnet.
ENTRYPOINT ["dotnet", "TodoApi.dll"]
